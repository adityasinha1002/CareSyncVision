# Backend Environment Configuration Template
# Set these as Railway environment variables (Railway → Service → Variables tab)
# Do NOT commit a real .env file with secrets.

# ========== FLASK CONFIGURATION ==========
FLASK_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-change-in-production
DEBUG=False

# ========== DATABASE CONFIGURATION ==========
# Railway provides DATABASE_URL automatically when you add a PostgreSQL plugin.
# Internal Railway URL format:
#   postgresql://postgres:<password>@postgres.railway.internal:5432/railway
# Public Railway URL format (use if internal doesn't work):
#   postgresql://postgres:<password>@<host>.railway.app:<port>/railway
DATABASE_URL=postgresql://postgres:your_password@postgres.railway.internal:5432/railway

# ========== GOOGLE OAUTH ==========
# Client ID from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized origins must include your Railway backend URL and https://caresyncvision.vercel.app
# Authorized redirect URIs: https://caresyncvision.vercel.app (for frontend-side flow)
GOOGLE_CLIENT_ID=174908944676-16i4b4pa0uic6gqta68rcj7t91dj1n3t.apps.googleusercontent.com

# ========== CORS CONFIGURATION ==========
# The Vercel frontend URL is already hard-coded in __init__.py.
# Add extra origins here as a comma-separated list if needed.
CORS_ORIGINS=

# ========== JWT CONFIGURATION ==========
# Must be the same secret used in FLASK_SECRET_KEY (they share the JWT secret).
JWT_EXPIRATION_HOURS=24

# ========== FILE UPLOAD ==========
UPLOAD_FOLDER=/tmp/caresynvision_uploads
MAX_IMAGE_SIZE=5242880

# ========== SERVICE CONFIGURATION ==========
PORT=5000
HOST=0.0.0.0

# ========== HEALTH ENGINE THRESHOLDS ==========
ACTIVITY_THRESHOLD=30
SLEEP_QUALITY_THRESHOLD=6
RISK_SCORE_THRESHOLD=70

# ========== LOGGING ==========
LOG_LEVEL=INFO
