{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "backend/Dockerfile",
    "buildContext": "backend"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "gunicorn main:app"
  },
  "networking": {
    "serviceDomains": {
      "caresyncvision.up.railway.app": {
        "port": 8080
      }
    }
  }
}
