# Frontend Environment Variables
# Copy this file to .env (local dev) or set these in Vercel → Project Settings → Environment Variables

# ── Main backend API ──────────────────────────────────────────────────────────
# Railway backend URL (set in Vercel env vars for production)
VITE_API_URL=https://caresyncvision-api-production.up.railway.app/api

# Local development
# VITE_API_URL=http://localhost:5000/api

# ── AI Analysis Server (optional) ────────────────────────────────────────────
# Only needed if you deploy the ai-server/ as a separate Railway service.
# Leave blank to hide AI Analysis features.
VITE_AI_SERVER_URL=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get this from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Leave blank to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=174908944676-16i4b4pa0uic6gqta68rcj7t91dj1n3t.apps.googleusercontent.com

# ── Miscellaneous ─────────────────────────────────────────────────────────────
VITE_APP_NAME=CareSyncVision
