# Frontend .env Example
# Update these values based on your deployment

# Production: Use Railway backend URL
VITE_API_URL=https://caresynvision-api-production.up.railway.app/api

# Development: Use localhost
# VITE_API_URL=http://localhost:5000/api

VITE_APP_NAME=CareSyncVision

# Google OAuth Client ID (from https://console.cloud.google.com/)
# Authorised JavaScript origins: https://caresyncvision.vercel.app, http://localhost:3000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI Server URL (separate service from the main backend)
# Set this to the deployed AI server URL when available
# Leave empty to disable AI features by default
VITE_AI_SERVER_URL=
