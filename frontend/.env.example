# Frontend .env Example
# Update these values based on your deployment

# Production: Use Railway backend URL
VITE_API_URL=https://caresynvision-api-production.up.railway.app/api

# Development: Use localhost
# VITE_API_URL=http://localhost:5000/api

VITE_APP_NAME=CareSyncVision

# Google OAuth Client ID (from Google Cloud Console > APIs & Services > Credentials)
# Leave blank to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=
